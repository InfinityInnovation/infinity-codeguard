generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum SessionState {
  ACTIVE
  REVOKED
}

enum RepositoryProvider {
  GITHUB
  GITLAB
  BITBUCKET
  AZURE_DEVOPS
  OTHER
}

enum ScanStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingStatus {
  OPEN
  CONFIRMED
  RESOLVED
  ACCEPTED_RISK
  FALSE_POSITIVE
}

enum QualityGateStatus {
  PENDING
  PASSED
  FAILED
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique @db.VarChar(254)
  displayName  String       @db.VarChar(100)
  passwordHash String
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  memberships  Membership[]
  sessions     Session[]
  auditEvents  AuditEvent[] @relation("AuditActor")
}

model Organization {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(100)
  slug         String       @unique @db.VarChar(64)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  memberships  Membership[]
  projects     Project[]
  repositories Repository[]
  scans        Scan[]
  findings     Finding[]
  auditEvents  AuditEvent[]
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  organizationId String         @db.Uuid
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Session {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  digest    String       @unique @db.Char(64)
  state     SessionState @default(ACTIVE)
  expiresAt DateTime     @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  revokedAt DateTime?    @db.Timestamptz(6)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, state])
  @@index([expiresAt])
}

model Project {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(120)
  slug           String       @db.VarChar(64)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  repositories   Repository[]
  scans          Scan[]
  findings       Finding[]

  @@unique([organizationId, slug])
  @@index([organizationId, createdAt])
}

model Repository {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  projectId      String             @db.Uuid
  name           String             @db.VarChar(120)
  remoteUrl      String             @db.VarChar(500)
  defaultBranch  String             @default("main") @db.VarChar(255)
  provider       RepositoryProvider
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(6)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scans          Scan[]

  @@unique([organizationId, remoteUrl])
  @@index([projectId, createdAt])
  @@index([organizationId, createdAt])
}

model Scan {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  projectId      String       @db.Uuid
  repositoryId   String       @db.Uuid
  status         ScanStatus   @default(QUEUED)
  scanner        String       @default("semgrep") @db.VarChar(40)
  commitSha      String?      @db.Char(40)
  errorMessage   String?      @db.VarChar(500)
  findingCount   Int          @default(0)
  criticalCount  Int          @default(0)
  highCount      Int          @default(0)
  mediumCount    Int          @default(0)
  lowCount       Int          @default(0)
  infoCount      Int          @default(0)
  qualityGate    QualityGateStatus @default(PENDING)
  queuedAt       DateTime     @default(now()) @db.Timestamptz(6)
  startedAt      DateTime?    @db.Timestamptz(6)
  completedAt    DateTime?    @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repository     Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  findings       Finding[]

  @@index([organizationId, queuedAt])
  @@index([projectId, queuedAt])
  @@index([repositoryId, queuedAt])
}

model Finding {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  projectId      String          @db.Uuid
  scanId         String          @db.Uuid
  ruleId         String          @db.VarChar(255)
  severity       FindingSeverity
  status         FindingStatus   @default(OPEN)
  message        String          @db.VarChar(2000)
  filePath       String          @db.VarChar(1000)
  startLine      Int
  endLine        Int
  fingerprint    String          @db.Char(64)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scan           Scan            @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, fingerprint])
  @@index([organizationId, severity])
  @@index([projectId, createdAt])
}

model AuditEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  actorId        String?       @db.Uuid
  action         String        @db.VarChar(120)
  targetType     String        @db.VarChar(80)
  targetId       String?       @db.VarChar(120)
  correlationId  String        @db.VarChar(100)
  metadata       Json?
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}
